# Django uses this only when its development proxy is used. Production Nginx
# should send /expert-qa/api/ directly to FastAPI on port 8080.
ATNP_QA_URL=http://127.0.0.1:8080

# Shared read-only retrieval data.
ATNP_KG_DB=/srv/atnp/data/knowledge_base_full.duckdb
ATNP_PASSAGE_INDEX=/srv/atnp/data/passages.sqlite

# OpenAI-compatible local model service.
VLLM_BASE_URL=http://127.0.0.1:18000
VLLM_MODEL=qwen32b-atnp
ATNP_MODEL_PATH=/srv/atnp/models/qwen_32B
ATNP_MODEL_GPUS=0
ATNP_TENSOR_PARALLEL_SIZE=1
ATNP_MAX_MODEL_LEN=12288
ATNP_MAX_NUM_SEQS=2

# The verified current service admits two running requests and four waiting.
ATNP_MODEL_BACKEND=vllm
ATNP_QUEUE_MAX_RUNNING=2
ATNP_QUEUE_MAX_WAITING=4
ATNP_QUEUE_WAIT_TIMEOUT=0

# Hybrid mode automatically falls back to rules when this optional service is unavailable.
ATNP_RERANK_BACKEND=hybrid
ATNP_RERANK_URL=http://127.0.0.1:18081
ATNP_RERANK_MODEL_PATH=/srv/atnp/models/bge-reranker-v2-m3
ATNP_RERANK_GPU=0
